provider "aws" {
  # set this to your desired region
  region = "us-east-1"
}

# Example usage of the onboarding module for an Upwind virtual organization.
# In a virtual organization there is no AWS Organization discovery: each account onboards itself. The module is
# applied to every account to be onboarded, typically via a deployment tool such as Terragrunt. In each account it
# creates the Account Service role and a one-shot Lambda that registers the account with Upwind.
module "upwind_virtual_org_account_onboarding" {
  source = "upwindsecurity/onboarding/aws"
  # Get versions from https://registry.terraform.io/modules/upwindsecurity/onboarding/aws/latest
  version = "~> 4.0"

  # Enable virtual organization mode. The Organization discovery role is not created in this mode.
  is_virtual_organization = true

  # The Cloud Organization ID generated by Upwind for your virtual organization (not an AWS Organization ID).
  upwind_cloud_organization_id = "<<upwind-cloud-organization-id>>"

  # The Upwind SaaS region your organization is hosted in. One of us, eu, ap, au.
  deployment_region = "us"

  # The external ID is provided by Upwind as part of the onboarding process.
  external_id = "F083B753-06B5-40B2-BE41-4035D6A7B6C7"

  # Required by the module. No discovery role is created for virtual organizations, but if this account is
  # onboarded too, enable install_roles_in_management_account so it receives the Account Service role.
  management_account_id               = "098765432109"
  install_roles_in_management_account = true

  # Optional. The account that hosts CloudScanner.
  orchestrator_account_id = "123456789012"

  # The role name suffix is a random set of characters that will be appended to each resource id to ensure uniqueness.
  role_name_suffix = "abcd1234"

  # The client credentials used by the onboarding Lambda (and CloudScanner). Provide them either as values, in which
  # case a Secrets Manager secret is created in each account...
  upwind_cloudscanner_auth_client_id    = "<<client-id>>"
  upwind_cloudscanner_auth_secret_value = "<<client-secret>>"

  # ...or as the ARN of an existing secret containing {"clientId": "...", "clientSecret": "..."}.
  # upwind_cloudscanner_auth_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:upwind-credentials"

  # Optionally attach a permissions boundary (ARN or policy name/path) to the onboarding Lambda's execution role.
  # single_account_onboarding_role_permissions_boundary = "MyPermissionsBoundary"

  # Set to false to create only the IAM roles and skip the onboarding Lambda.
  # upwind_single_account_onboarding_lambda_enabled = false
}
