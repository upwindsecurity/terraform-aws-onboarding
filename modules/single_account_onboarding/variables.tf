variable "cloud_organization_id" {
  description = "Cloud Organization ID generated by Upwind - Not an AWS organization ID"
  type        = string
  nullable    = false
}

variable "upwind_lambda_execution_role_name" {
  type    = string
  default = "UpwindOnboardingLambdaExecutionRole"
}

variable "deployment_region" {
  description = "Upwind SaaS region the account is onboarded to. Selects the Upwind auth and API endpoints."
  type        = string
  validation {
    condition     = contains(["us", "eu", "ap", "au", "dev"], var.deployment_region)
    error_message = "deployment_region must be one of us, eu, ap, au, dev."
  }
}

variable "iam_role_path" {
  description = "The IAM path applied to the Lambda execution role. Must begin and end with a forward slash (/). Defaults to \"/\" (the AWS default)."
  type        = string
  default     = "/"
}

variable "permissions_boundary" {
  description = <<EOT
(Optional). A pre-existing IAM permissions boundary policy to attach to the Lambda execution role. Provide either
the full policy ARN or just the policy name including any path but WITHOUT a leading slash, in which case the ARN
is formed for this account. Leave null to create the role without a permissions boundary.
  EOT
  type        = string
  default     = null
}

variable "role_name_suffix" {
  type = string
}

variable "upwind_onboarding_lambda_name_prefix" {
  type    = string
  default = "upwind-single-account-onboarding"
}

variable "custom_tags" {
  type    = map(string)
  default = {}
}

variable "upwind_serverless_bucket_prefix" {
  description = "Bucket that stores the single account onboarding lambda only used for upwind managed orgs"
  type        = string
  default     = "upwind-serverless-functions"
  validation {
    condition     = length(var.upwind_serverless_bucket_prefix) > 0
    error_message = "The Upwind Serverless bucket host must not be empty."
  }
}

variable "upwind_client_credentials_secret_arn" {
  description = "Secretsmanager secret ARN of upwind client credentials"
  type        = string
}
